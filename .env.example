# Contoh Konfigurasi Environment SIAKAD (Salin ke .env sebelum menjalankan aplikasi)
DATABASE_URL=sqlite:///./pmb.db
# Contoh untuk PostgreSQL / MySQL:
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/siakad_db

# Kunci HMAC untuk Token Autentikasi & Signature Webhook (Ganti pada environment produksi)
SECRET_KEY=replace-with-your-hmac-secret-key
WEBHOOK_SECRET=replace-with-your-webhook-hmac-secret
